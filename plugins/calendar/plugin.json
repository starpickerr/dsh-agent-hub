{
  "manifestVersion": 1,
  "id": "stella.calendar",
  "name": "日程",
  "version": "1.1.3",
  "hostApi": "^1.0.0",
  "runtime": {
    "kind": "python",
    "entry": "backend/main.py",
    "abi": "cp312"
  },
  "data": {
    "namespace": "stella.calendar",
    "schemaVersion": 1,
    "migrationEntry": "backend/migrate.py"
  },
  "contributes": {
    "services": [
      "stella.calendar@1"
    ],
    "pages": [
      "calendar.main"
    ],
    "settings": [
      "calendar.preferences"
    ]
  },
  "permissions": [
    {
      "capability": "calendar.read",
      "required": true
    },
    {
      "capability": "calendar.write",
      "required": true
    }
  ],
  "description": {
    "zh": "创建、查询和维护日程、分类及重复事件。可在日程页面安排活动，在配置中管理 Apple 日历连接与同步。",
    "en": "Create and manage events, categories, and recurring schedules. Plan activities on the Calendar page and manage Apple Calendar connections and sync under Configuration."
  }
}
