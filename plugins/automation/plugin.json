{
  "manifestVersion": 1,
  "id": "stella.automation",
  "name": "自动化",
  "version": "1.0.4",
  "hostApi": "^1.0.0",
  "runtime": {
    "kind": "python",
    "entry": "backend/main.py",
    "abi": "cp312"
  },
  "data": {
    "namespace": "stella.automation",
    "schemaVersion": 1,
    "migrationEntry": "backend/migrate.py"
  },
  "contributes": {
    "services": [
      "stella.automation@1"
    ],
    "pages": [
      "automation.main"
    ],
    "settings": [
      "automation.preferences"
    ]
  },
  "permissions": [
    {
      "capability": "automation.read",
      "required": true
    },
    {
      "capability": "automation.write",
      "required": true
    }
  ],
  "description": {
    "zh": "创建和管理定时任务、提醒与周期性自动化规则。后台执行沿用任务的权限模式，通知使用已配置的渠道。",
    "en": "Create and manage scheduled tasks, reminders, and recurring automation rules. Background runs use the task permission mode and notifications use configured channels."
  }
}
