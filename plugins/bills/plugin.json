{
  "manifestVersion": 1,
  "id": "stella.bills",
  "name": "账单",
  "version": "1.1.3",
  "hostApi": "^1.0.0",
  "runtime": {
    "kind": "python",
    "entry": "backend/main.py",
    "abi": "cp312"
  },
  "data": {
    "namespace": "stella.bills",
    "schemaVersion": 1,
    "migrationEntry": "backend/migrate.py"
  },
  "contributes": {
    "services": [
      "stella.bills@1"
    ],
    "pages": [
      "bills.main"
    ],
    "settings": [
      "bills.preferences"
    ]
  },
  "permissions": [
    {
      "capability": "bills.read",
      "required": true
    },
    {
      "capability": "bills.write",
      "required": true
    }
  ],
  "description": {
    "zh": "记录和查询个人收支，维护账单分类并查看月度、年度汇总。可在账单页面管理记录，在配置中调整插件选项。",
    "en": "Record and search personal income and expenses, manage categories, and review monthly or yearly totals. Manage records on the Bills page and plugin options under Configuration."
  }
}
