{
  "manifestVersion": 1,
  "id": "stella.briefing",
  "name": "简报",
  "version": "1.1.6",
  "hostApi": "^1.0.0",
  "runtime": {
    "kind": "python",
    "entry": "backend/main.py",
    "abi": "cp312"
  },
  "data": {
    "namespace": "stella.briefing",
    "schemaVersion": 1,
    "migrationEntry": "backend/migrate.py"
  },
  "contributes": {
    "services": [
      "stella.briefing@1"
    ],
    "pages": [
      "briefing.main"
    ],
    "settings": [
      "briefing.preferences"
    ]
  },
  "permissions": [
    {
      "capability": "briefing.read",
      "required": true
    },
    {
      "capability": "briefing.write",
      "required": true
    }
  ],
  "description": {
    "zh": "汇总已配置来源的信息，生成和查看每日简报，维护简报条目与规则。生成结果取决于可用来源及当前授权范围。",
    "en": "Collect information from configured sources, generate and review daily briefings, and manage items and rules. Results depend on available sources and current access permissions."
  }
}
