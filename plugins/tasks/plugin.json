{
  "manifestVersion": 1,
  "id": "stella.tasks",
  "name": "事务",
  "version": "1.1.4",
  "hostApi": "^1.0.0",
  "runtime": {
    "kind": "python",
    "entry": "backend/main.py",
    "abi": "cp312"
  },
  "data": {
    "namespace": "stella.tasks",
    "schemaVersion": 1,
    "migrationEntry": "backend/migrate.py"
  },
  "contributes": {
    "services": [
      "stella.tasks@1"
    ],
    "pages": [
      "tasks.main"
    ],
    "settings": [
      "tasks.preferences"
    ]
  },
  "permissions": [
    {
      "capability": "tasks.read",
      "required": true
    },
    {
      "capability": "tasks.write",
      "required": true
    }
  ],
  "description": {
    "zh": "管理事务、子事务、排序和完成状态。可在事务页面整理待办，在配置中管理 Apple 提醒事项连接与同步。",
    "en": "Manage tasks, subtasks, ordering, and completion status. Organize work on the Tasks page and manage Apple Reminders connections and sync under Configuration."
  }
}
